    "version": "0.2.0",
    "configurations": [
        

        {
            "name": "Run Validator",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/FlowValidator/bin/Debug/net9.0/FlowValidator.dll",
            "args": [],
            "console": "externalTerminal"
        },

        {
            "name": "MCP Server",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/FsOpMCPServer/bin/Debug/net9.0/FsOpMCPServer.dll",
            "args": [],
        },
        {
            "name": "Run CUA",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/RTTest/bin/Debug/net9.0/RTTest.dll",
            "args": [],
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
