{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Fast Client - Debug Server",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build: solution",
            "launchSettingsFilePath": "${workspaceFolder}/src/TMOnboard.Server/Properties/launchSettings.json",
            "launchSettingsProfile": "TMOnboard.Server",
            "program": "${workspaceFolder}/src/TMOnboard.Server/bin/Debug/net9.0/TMOnboard.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/TMOnboard.Server",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "WASM Debug",
            "type": "blazorwasm",
            "hosted": true,
            "request": "launch",
            "preLaunchTask": "Build: solution",
            "launchSettingsFilePath": "${workspaceFolder}/src/TMOnboard.Server/Properties/launchSettings.json",
            "launchSettingsProfile": "TMOnboard.Server",
            "program": "${workspaceFolder}/src/TMOnboard.Server/bin/Debug/net9.0/TMOnboard.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/TMOnboard.Server",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "Deprecated: Debug Client+Server",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build: solution",
            "launchSettingsFilePath": "${workspaceFolder}/src/TMOnboard.Server/Properties/launchSettings.json",
            "launchSettingsProfile": "TMOnboard.Server",
            "program": "${workspaceFolder}/src/TMOnboard.Server/bin/Debug/net9.0/TMOnboard.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/TMOnboard.Server",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s?server=true"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
}